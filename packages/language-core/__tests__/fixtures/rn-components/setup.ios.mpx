<template>
  <NativeView testID="footer" onLayout="{{ handleFooterLayout }}" />
  <FunctionAlias title="function" count="{{ 1 }}" onLayout="{{ handleFooterLayout }}" />
  <ClassAlias title="class" count="{{ 1 }}" onLayout="{{ handleFooterLayout }}" />
  <ForwardAlias title="forward" count="{{ 1 }}" onLayout="{{ handleFooterLayout }}" />
</template>
<script setup lang="ts">
import { View, type ViewProps } from 'react-native'
import { FunctionPanel, ClassPanel, ForwardPanel } from './components'
const handleFooterLayout: NonNullable<ViewProps['onLayout']> = event => {
  const height: number = event.nativeEvent.layout.height
  return height
}
defineOptions({ components: { NativeView: View, FunctionAlias: FunctionPanel, ClassAlias: ClassPanel, ForwardAlias: ForwardPanel } })
defineExpose({ handleFooterLayout })
</script>
