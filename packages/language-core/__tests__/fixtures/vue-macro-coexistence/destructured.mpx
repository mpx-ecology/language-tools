<template>
  <view>{{ title.toUpperCase() }} {{ count.toFixed() }}</view>
</template>

<script setup lang="ts">
const { title: heading, count } = defineProps({
  title: { type: String, value: 'hello' },
  count: { type: Number, value: 1 },
})

heading.toUpperCase()
count.toFixed()
defineExpose({ heading })
</script>
