<template>
  <view>{{ title.toUpperCase() }} {{ profile.name.toUpperCase() }}</view>
</template>

<script setup lang="ts">
interface Profile {
  name: string
}

const props = withDefaults(
  defineProps<{ title?: string; profile?: Profile; count?: number }>(),
  { title: 'hello', profile: { name: 'mpx' }, count: 1 },
)

props.title.toUpperCase()
props.profile.name.toUpperCase()
props.count.toFixed()

defineExpose({ props })
</script>
