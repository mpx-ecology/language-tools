<template>
  <component
    is="{{ currentPanel }}"
    range="platform-hold-panel,carpool-hold-panel,layout-panel"
  />
  <carpool-hold-panel />
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'

