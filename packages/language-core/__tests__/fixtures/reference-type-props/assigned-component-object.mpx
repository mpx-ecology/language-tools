<script name="json">
const miniComponents = {}
if (__mpx_mode__ === 'wx') {
  miniComponents['carpool-hold-panel'] = './component-options.mpx?root=demo'
}
module.exports = {
  usingComponents: {
    ...miniComponents,
    'platform-hold-panel': './component-options.mpx',
    'layout-panel': './component-setup-props.mpx'
  }
}
</script>
