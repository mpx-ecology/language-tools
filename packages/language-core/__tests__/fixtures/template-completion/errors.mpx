<template>
  <!-- Intentional error: Ref is unwrapped to number, without this member. -->
  <text>{{ publicCount.missing }}</text>
  <!-- Intentional error: compact capture handlers must check missing template variables. -->
  <view capture-bindtap="missingCapture" />
</template>
<script setup lang="ts">
import { ref } from '@mpxjs/core'
const localCount = ref(1)
defineExpose({ publicCount: localCount })
</script>
