<template>
  <!-- Valid: the component defaults type to 'back'. -->
  <back label="Return" />
  <!-- Expected TS2322: type must be a string. -->
  <back type="{{ 42 }}" label="Return" />
  <!-- Expected TS2345: label has no default and is required. -->
  <back type="back" />
  <!-- Expected TS2345: an invalid withDefaults call does not make type optional. -->
  <asserted-back label="Return" />
</template>

<script type="application/json">
{
  "usingComponents": {
    "back": "./component-with-default",
    "asserted-back": "./component-with-asserted-props"
  }
}
</script>
