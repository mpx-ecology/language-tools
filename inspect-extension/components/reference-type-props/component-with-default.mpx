<script setup lang="ts">
interface Props {
  /** Display mode for the back button. */
  type: string
  label: string
}

const props = withDefaults(defineProps<Props>(), {
  type: 'back',
  get label() { return 'Return' },
})
// Hover props.type: it should still be string inside the component.
const displayType = props.type
defineExpose({ displayType })
</script>

<script type="application/json">
{ "component": true }
</script>
