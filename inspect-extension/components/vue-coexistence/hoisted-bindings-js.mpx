<script setup>
// @ts-check
import * as macros from './local-macros'

if (true) {
  var mpxProps = macros.defineProps
  var mpxDefaults = macros.withDefaults
}

// Expected: the local JavaScript functions keep their imported signatures.
const props = mpxDefaults(mpxProps('local'))
props.localCount.toFixed()

// Expected: localCount hover is number; F12 and F2 preserve the local var bindings.
// Intentional error: TS2339, number has no toUpperCase().
if (false) {
  props.localCount.toUpperCase()
}
defineExpose({ props })
</script>
