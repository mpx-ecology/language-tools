<script setup lang="ts">
import * as helpers from './local-macros'

if (true) {
  var mpxProps = helpers.defineProps
  var mpxDefaults = helpers.withDefaults
}

// Expected: these bound aliases are ordinary runtime functions, not Mpx macros.
const props = mpxDefaults(mpxProps('local'))
props.localCount.toFixed()

// Expected: F12 on either call reaches its var declaration above.
// F2 from a declaration or call must include both declaration and call.
// Intentional error: TS2339, number has no toUpperCase().
if (false) {
  props.localCount.toUpperCase()
}
defineExpose({ props })
</script>
