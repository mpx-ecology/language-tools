<template>
  <!-- Cmd/Ctrl 点击和 F12：三个 range 名称都应跳转到 panel.mpx。 -->
  <component
    wx:if="{{ currentPanel }}"
    is="{{ currentPanel }}"
    range="platform-hold-panel,carpool-hold-panel,layout-panel"
  />
  <!-- 普通标签也应识别注册，并提供 parentText 属性提示和 String 类型悬浮。 -->
  <carpool-hold-panel parentText="demo" />
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'

createComponent({
  data: {
    currentPanel: 'carpool-hold-panel'
  }
})
</script>

<script name="json">
function unrelated() {
  const miniComponents = {}
  // 这是另一个局部对象：两处不存在的路径均不应报 mpx-json 4001。
  // 这里的注册不应影响 range 跳转或普通标签的属性提示。
  miniComponents['carpool-hold-panel'] = './missing-shadowed.mpx'
  Object.assign(miniComponents, { ghost: './missing-assign.mpx' })
}
const miniComponents = {}
if (__mpx_mode__ === 'wx') {
  // 路径也应可跳转；query 不影响目标文件解析。
  miniComponents['carpool-hold-panel'] = './panel.mpx?root=demo'
}
// 计算方法名在外层求值，不能把这里的 miniComponents 当成方法形参。
const methods = {
  [(Object.assign(miniComponents, {
    'layout-panel': './panel.mpx'
  }), 'register')](miniComponents) {}
}
// exports 是 Mpx 注入的 CommonJS 变量，此路径也应能跳转。
Object.assign(exports, { 'platform-hold-panel': './panel.mpx' })
function build(config = {
  component: true,
  usingComponents: { ...miniComponents, ...exports }
}) {
  // 函数体的 var 不影响默认参数；这里不应报 mpx-json 4001。
  var miniComponents = {
    ghost: './missing-default.mpx'
  }
  return config
}
module.exports = build()
</script>
