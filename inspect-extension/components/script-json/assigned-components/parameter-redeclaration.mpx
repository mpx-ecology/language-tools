<template>
  <!-- F12 应跳转 panel.mpx，parentText 应提供 String 类型的属性提示。 -->
  <parameter-panel parentText="demo" />
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'

createComponent({})
</script>

<script name="json">
function build(components = {}, config = { usingComponents: components }) {
  // 裸 var 和 Object.assign 的返回值均保留原形参对象。
  // 标签及下方路径应能跳转，组件注册和属性提示不能丢失或重复。
  var components
  var components = Object.assign(components, { 'parameter-panel': './panel.mpx' })
  return config
}
module.exports = build()
</script>
