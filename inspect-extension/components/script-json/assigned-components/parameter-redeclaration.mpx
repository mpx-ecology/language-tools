<template>
  <!-- F12 应跳转 panel.mpx，parentText 应提供 String 类型的属性提示。 -->
  <parameter-panel parentText="demo" />
</template>

<script lang="ts">
import { createComponent } from '@mpxjs/core'

createComponent({})
</script>

<script name="json">
function build(components = {}, config = { usingComponents: components }) {
  // 裸 var 保留形参对象，不能导致组件注册或路径跳转丢失。
  var components
  Object.assign(components, { 'parameter-panel': './panel.mpx' })
  return config
}
module.exports = build()
</script>
